11:["$","section","Create a testable system",{"id":"s3","children":[["$","h2",null,{"children":"Create a testable system"}],[["$","p","Generate variations that change one factor at a time: background color, crop, object size or expression. This makes performance data interpretable.",{"children":"Generate variations that change one factor at a time: background color, crop, object size or expression. This makes performance data interpretable."}],["$","p","Keep a consistent visual language across a series so returning viewers can recognize the channel before reading the title.",{"children":"Keep a consistent visual language across a series so returning viewers can recognize the channel before reading the title."}]]]}]
