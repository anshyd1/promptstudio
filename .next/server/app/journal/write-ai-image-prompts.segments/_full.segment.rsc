11:["$","section","Use camera language only when it changes the result",{"id":"s2","children":[["$","h2",null,{"children":"Use camera language only when it changes the result"}],[["$","p","Lens and aperture descriptions can guide framing and depth, but they are not magic quality commands. A 24mm lens suggests a wider spatial relationship; an 85mm lens suggests portrait compression; a macro lens suggests close detail. Choose the language because it supports the job.",{"children":"Lens and aperture descriptions can guide framing and depth, but they are not magic quality commands. A 24mm lens suggests a wider spatial relationship; an 85mm lens suggests portrait compression; a macro lens suggests close detail. Choose the language because it supports the job."}],["$","p","Aspect ratio is equally important. Decide whether the image is for a square marketplace listing, a 4:5 social post, a 16:9 thumbnail or a wide website hero before generating. Reframing later can destroy the composition.",{"children":"Aspect ratio is equally important. Decide whether the image is for a square marketplace listing, a 4:5 social post, a 16:9 thumbnail or a wide website hero before generating. Reframing later can destroy the composition."}]]]}]
12:["$","section","Protect what must not change",{"id":"s3","children":[["$","h2",null,{"children":"Protect what must not change"}],[["$","p","Editing prompts should separate protected source details from editable decisions. For a product, protect shape, label, color and included parts. For a person, protect identity, age, skin tone and natural features. For architecture, protect the real floor plan and view.",{"children":"Editing prompts should separate protected source details from editable decisions. For a product, protect shape, label, color and included parts. For a person, protect identity, age, skin tone and natural features. For architecture, protect the real floor plan and view."}],["$","p","Review output at full resolution. Check hands, eyes, text, logos, edges, reflections and repeated patterns. A visually impressive thumbnail can still contain errors that make it unusable commercially.",{"children":"Review output at full resolution. Check hands, eyes, text, logos, edges, reflections and repeated patterns. A visually impressive thumbnail can still contain errors that make it unusable commercially."}]]]}]
13:["$","div",null,{"className":"takeaways","children":[["$","span",null,{"children":"KEY TAKEAWAYS"}],["$","ul",null,{"children":[["$","li","Define the commercial job first.",{"children":[["$","$L15",null,{"ref":"$undefined","iconNode":[["path",{"d":"M20 6 9 17l-5-5","key":"1gmf2c"}]],"className":"lucide-check","size":17}],"Define the commercial job first."]}],["$","li","Use a repeatable production order.",{"children":[["$","$L15",null,{"ref":"$undefined","iconNode":"$13:props:children:1:props:children:0:props:children:0:props:iconNode","className":"lucide-check","size":17}],"Use a repeatable production order."]}],["$","li","Choose camera and ratio intentionally.",{"children":[["$","$L15",null,{"ref":"$undefined","iconNode":"$13:props:children:1:props:children:0:props:children:0:props:iconNode","className":"lucide-check","size":17}],"Choose camera and ratio intentionally."]}],["$","li","State immutable details explicitly.",{"children":[["$","$L15",null,{"ref":"$undefined","iconNode":"$13:props:children:1:props:children:0:props:children:0:props:iconNode","className":"lucide-check","size":17}],"State immutable details explicitly."]}],["$","li","Review at full resolution.",{"children":[["$","$L15",null,{"ref":"$undefined","iconNode":"$13:props:children:1:props:children:0:props:children:0:props:iconNode","className":"lucide-check","size":17}],"Review at full resolution."]}]]}]]}]
