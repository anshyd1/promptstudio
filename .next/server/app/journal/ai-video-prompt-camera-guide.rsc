7:[["$","section",null,{"className":"pageHero","children":[["$","span",null,{"children":"VIDEO PROMPTING · 12 MIN"}],["$","h1",null,{"children":"AI Video Prompting: Camera, Continuity and Sound."}],["$","p",null,{"children":"Turn an idea into a sequence that a video model can execute consistently."}]]}],["$","article",null,{"className":"article guideArticle","children":[["$","div",null,{"className":"articleMeta","children":[["$","span",null,{"children":"Published September 3, 2026"}],["$","span",null,{"children":"Editorial team · PromptStudio AI"}]]}],["$","p",null,{"className":"lead","children":"Video prompting adds time, motion and sound to visual direction. A good prompt does not merely describe a beautiful frame; it describes what changes and what remains consistent across the shot."}],["$","nav",null,{"className":"toc","children":[["$","b",null,{"children":"IN THIS GUIDE"}],[["$","a","Define one shot before defining a film",{"href":"#s0","children":[1,". ","Define one shot before defining a film"]}],["$","a","Use camera movement with purpose",{"href":"#s1","children":[2,". ","Use camera movement with purpose"]}],["$","a","Protect continuity and physics",{"href":"#s2","children":[3,". ","Protect continuity and physics"]}],["$","a","Direct sound as a separate layer",{"href":"#s3","children":[4,". ","Direct sound as a separate layer"]}]]]}],[["$","section","Define one shot before defining a film",{"id":"s0","children":[["$","h2",null,{"children":"Define one shot before defining a film"}],[["$","p","Begin with a single action, camera move and duration. “The camera slowly tracks beside the vehicle as it enters morning fog” is easier to execute than a paragraph containing five locations and six cuts.",{"children":"Begin with a single action, camera move and duration. “The camera slowly tracks beside the vehicle as it enters morning fog” is easier to execute than a paragraph containing five locations and six cuts."}],["$","p","For a multi-shot sequence, label each shot and keep transitions explicit. Reintroduce immutable subject details when consistency is critical.",{"children":"For a multi-shot sequence, label each shot and keep transitions explicit. Reintroduce immutable subject details when consistency is critical."}]]]}],["$","section","Use camera movement with purpose",{"id":"s1","children":[["$","h2",null,{"children":"Use camera movement with purpose"}],[["$","p","A dolly-in increases attention. A lateral tracking move reveals shape and motion. A locked camera emphasizes performance within the frame. Choose one dominant movement and describe speed and stability.",{"children":"A dolly-in increases attention. A lateral tracking move reveals shape and motion. A locked camera emphasizes performance within the frame. Choose one dominant movement and describe speed and stability."}],["$","p","Avoid stacking crane, orbit, zoom and handheld movement unless the sequence truly requires it. Conflicting camera verbs often produce unstable geometry.",{"children":"Avoid stacking crane, orbit, zoom and handheld movement unless the sequence truly requires it. Conflicting camera verbs often produce unstable geometry."}]]]}],["$","section","Protect continuity and physics",{"id":"s2","children":[["$","h2",null,{"children":"Protect continuity and physics"}],[["$","p","State what must remain consistent: face, wardrobe, vehicle geometry, product packaging, weather and time of day. Mention realistic weight, cloth behavior, reflections and contact with surfaces.",{"children":"State what must remain consistent: face, wardrobe, vehicle geometry, product packaging, weather and time of day. Mention realistic weight, cloth behavior, reflections and contact with surfaces."}],"$L11"]]}],"$L12"],"$L13","$L14"]}]]
