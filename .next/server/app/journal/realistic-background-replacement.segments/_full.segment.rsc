7:[["$","section",null,{"className":"pageHero","children":[["$","span",null,{"children":"PHOTO EDITING · 8 MIN"}],["$","h1",null,{"children":"How to Write a Realistic Background-Replacement Prompt."}],["$","p",null,{"children":"Match perspective, light, depth and edges so the edit feels like one photograph."}]]}],["$","article",null,{"className":"article guideArticle","children":[["$","div",null,{"className":"articleMeta","children":[["$","span",null,{"children":"Published September 3, 2026"}],["$","span",null,{"children":"Editorial team · PromptStudio AI"}]]}],["$","p",null,{"className":"lead","children":"Most failed background replacements are not caused by the background itself. They fail because the subject and environment appear to belong to different photographs."}],["$","nav",null,{"className":"toc","children":[["$","b",null,{"children":"IN THIS GUIDE"}],[["$","a","Preserve the foreground first",{"href":"#s0","children":[1,". ","Preserve the foreground first"]}],["$","a","Match camera and scale",{"href":"#s1","children":[2,". ","Match camera and scale"]}],["$","a","Rebuild environmental light",{"href":"#s2","children":[3,". ","Rebuild environmental light"]}],["$","a","Inspect the composite",{"href":"#s3","children":[4,". ","Inspect the composite"]}]]]}],[["$","section","Preserve the foreground first",{"id":"s0","children":[["$","h2",null,{"children":"Preserve the foreground first"}],[["$","p","State that the subject, face, hair, clothing, pose and foreground objects must remain unchanged. Complex edges—hair, glass, lace and motion blur—need particular care. Ask for clean natural transitions rather than a visibly cut-out mask.",{"children":"State that the subject, face, hair, clothing, pose and foreground objects must remain unchanged. Complex edges—hair, glass, lace and motion blur—need particular care. Ask for clean natural transitions rather than a visibly cut-out mask."}],["$","p","If the original photograph contains colored light reflected on the subject, the new environment should plausibly produce that color. Otherwise the subject will look pasted into the scene.",{"children":"If the original photograph contains colored light reflected on the subject, the new environment should plausibly produce that color. Otherwise the subject will look pasted into the scene."}]]]}],["$","section","Match camera and scale",{"id":"s1","children":[["$","h2",null,{"children":"Match camera and scale"}],[["$","p","Describe the new environment from the same camera height and approximate lens perspective as the source. A close wide-angle selfie will not naturally fit a distant telephoto office background.",{"children":"Describe the new environment from the same camera height and approximate lens perspective as the source. A close wide-angle selfie will not naturally fit a distant telephoto office background."}],["$","p","Use architectural lines and known objects to judge scale. The horizon, floor plane and vanishing points should support the subject’s feet, chair or contact surface.",{"children":"Use architectural lines and known objects to judge scale. The horizon, floor plane and vanishing points should support the subject’s feet, chair or contact surface."}]]]}],["$","section","Rebuild environmental light",{"id":"s2","children":[["$","h2",null,{"children":"Rebuild environmental light"}],[["$","p","Specify the direction, softness and temperature of the new light. Ask for matching contact shadows, reflected color and edge light. A bright window on the left should affect the subject from the left.",{"children":"Specify the direction, softness and temperature of the new light. Ask for matching contact shadows, reflected color and edge light. A bright window on the left should affect the subject from the left."}],"$L11"]]}],"$L12"],"$L13","$L14"]}]]
