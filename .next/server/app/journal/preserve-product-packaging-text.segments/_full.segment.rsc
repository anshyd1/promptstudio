7:[["$","section",null,{"className":"pageHero","children":[["$","span",null,{"children":"PRODUCT ACCURACY · 9 MIN"}],["$","h1",null,{"children":"How to Preserve Packaging and Logos in AI Product Images."}],["$","p",null,{"children":"Practical constraints for labels, materials and product geometry."}]]}],["$","article",null,{"className":"article guideArticle","children":[["$","div",null,{"className":"articleMeta","children":[["$","span",null,{"children":"Published September 3, 2026"}],["$","span",null,{"children":"Editorial team · PromptStudio AI"}]]}],["$","p",null,{"className":"lead","children":"Packaging is identity, information and often regulated copy. Small generative changes can turn a polished campaign image into an unusable commercial asset."}],["$","nav",null,{"className":"toc","children":[["$","b",null,{"children":"IN THIS GUIDE"}],[["$","a","Use the product as an immutable reference",{"href":"#s0","children":[1,". ","Use the product as an immutable reference"]}],["$","a","Separate scene generation from typography",{"href":"#s1","children":[2,". ","Separate scene generation from typography"]}],["$","a","Control reflections and occlusion",{"href":"#s2","children":[3,". ","Control reflections and occlusion"]}],["$","a","Build a commercial review checklist",{"href":"#s3","children":[4,". ","Build a commercial review checklist"]}]]]}],[["$","section","Use the product as an immutable reference",{"id":"s0","children":[["$","h2",null,{"children":"Use the product as an immutable reference"}],[["$","p","State that bottle shape, cap, label dimensions, logo placement, color and printed copy cannot change. Provide a high-resolution image where those elements are clearly visible.",{"children":"State that bottle shape, cap, label dimensions, logo placement, color and printed copy cannot change. Provide a high-resolution image where those elements are clearly visible."}],["$","p","If the platform supports multiple references, include front, side and three-quarter views. Do not ask the model to invent unseen packaging details.",{"children":"If the platform supports multiple references, include front, side and three-quarter views. Do not ask the model to invent unseen packaging details."}]]]}],["$","section","Separate scene generation from typography",{"id":"s1","children":[["$","h2",null,{"children":"Separate scene generation from typography"}],[["$","p","Generate environment, surfaces, shadows and broad reflections while protecting the product area. Add exact campaign copy and legal information later in a layout application.",{"children":"Generate environment, surfaces, shadows and broad reflections while protecting the product area. Add exact campaign copy and legal information later in a layout application."}],["$","p","Image models may render plausible-looking but incorrect words. Even when a label appears correct at thumbnail size, inspect every character at full resolution.",{"children":"Image models may render plausible-looking but incorrect words. Even when a label appears correct at thumbnail size, inspect every character at full resolution."}]]]}],["$","section","Control reflections and occlusion",{"id":"s2","children":[["$","h2",null,{"children":"Control reflections and occlusion"}],[["$","p","Glossy packaging reflects the environment. Ask for physically plausible highlights that reveal form without covering the label. Keep props and hands away from critical information unless the shot intentionally demonstrates use.",{"children":"Glossy packaging reflects the environment. Ask for physically plausible highlights that reveal form without covering the label. Keep props and hands away from critical information unless the shot intentionally demonstrates use."}],"$L11"]]}],"$L12"],"$L13","$L14"]}]]
