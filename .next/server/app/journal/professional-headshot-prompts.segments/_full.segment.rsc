11:["$","h2",null,{"children":"Match the profession and context"}]
12:["$","p","A technology founder may suit a smart-casual portrait with a contemporary workspace. A financial adviser may need restrained tailoring and a neutral studio. A therapist may benefit from warm window light and a calm environment. The goal is not to stereotype a profession but to align visual signals with audience expectations.",{"children":"A technology founder may suit a smart-casual portrait with a contemporary workspace. A financial adviser may need restrained tailoring and a neutral studio. A therapist may benefit from warm window light and a calm environment. The goal is not to stereotype a profession but to align visual signals with audience expectations."}]
13:["$","p","Create a vertical master with room around the shoulders, then crop versions for LinkedIn, speaker pages and company directories. Keep the face large enough to remain recognizable in a small circular avatar.",{"children":"Create a vertical master with room around the shoulders, then crop versions for LinkedIn, speaker pages and company directories. Keep the face large enough to remain recognizable in a small circular avatar."}]
14:["$","section","Perform an identity audit",{"id":"s3","children":[["$","h2",null,{"children":"Perform an identity audit"}],[["$","p","Compare the result with the source side by side. Check eye spacing, eyelids, smile shape, teeth, ears, hairline, skin tone and apparent age. Reject outputs that look more glamorous but less accurate.",{"children":"Compare the result with the source side by side. Check eye spacing, eyelids, smile shape, teeth, ears, hairline, skin tone and apparent age. Reject outputs that look more glamorous but less accurate."}],["$","p","Disclose synthetic or heavily edited portraits when context requires it. Never create professional images of another real person without permission.",{"children":"Disclose synthetic or heavily edited portraits when context requires it. Never create professional images of another real person without permission."}]]]}]
15:["$","div",null,{"className":"takeaways","children":[["$","span",null,{"children":"KEY TAKEAWAYS"}],["$","ul",null,{"children":[["$","li","Use a clear unfiltered source.",{"children":[["$","$L17",null,{"ref":"$undefined","iconNode":[["path",{"d":"M20 6 9 17l-5-5","key":"1gmf2c"}]],"className":"lucide-check","size":17}],"Use a clear unfiltered source."]}],["$","li","Protect identity before changing style.",{"children":[["$","$L17",null,{"ref":"$undefined","iconNode":"$15:props:children:1:props:children:0:props:children:0:props:iconNode","className":"lucide-check","size":17}],"Protect identity before changing style."]}],["$","li","Choose industry-appropriate presentation.",{"children":[["$","$L17",null,{"ref":"$undefined","iconNode":"$15:props:children:1:props:children:0:props:children:0:props:iconNode","className":"lucide-check","size":17}],"Choose industry-appropriate presentation."]}],["$","li","Generate for multiple crops.",{"children":[["$","$L17",null,{"ref":"$undefined","iconNode":"$15:props:children:1:props:children:0:props:children:0:props:iconNode","className":"lucide-check","size":17}],"Generate for multiple crops."]}],["$","li","Reject flattering but inaccurate results.",{"children":[["$","$L17",null,{"ref":"$undefined","iconNode":"$15:props:children:1:props:children:0:props:children:0:props:iconNode","className":"lucide-check","size":17}],"Reject flattering but inaccurate results."]}]]}]]}]
