7:[["$","section",null,{"className":"pageHero","children":[["$","span",null,{"children":"PROFESSIONAL PORTRAITS · 9 MIN"}],["$","h1",null,{"children":"Professional Headshot Prompts That Preserve Identity."}],["$","p",null,{"children":"How to improve wardrobe, background and light without producing a different person."}]]}],["$","article",null,{"className":"article guideArticle","children":[["$","div",null,{"className":"articleMeta","children":[["$","span",null,{"children":"Published September 3, 2026"}],["$","span",null,{"children":"Editorial team · PromptStudio AI"}]]}],["$","p",null,{"className":"lead","children":"A successful AI headshot should look like the same person on a very good professional day—not a polished stranger. Identity protection is therefore the first instruction, not an afterthought."}],["$","nav",null,{"className":"toc","children":[["$","b",null,{"children":"IN THIS GUIDE"}],[["$","a","Start with a suitable reference",{"href":"#s0","children":[1,". ","Start with a suitable reference"]}],["$","a","Separate identity from presentation",{"href":"#s1","children":[2,". ","Separate identity from presentation"]}],["$","a","Match the profession and context",{"href":"#s2","children":[3,". ","Match the profession and context"]}],["$","a","Perform an identity audit",{"href":"#s3","children":[4,". ","Perform an identity audit"]}]]]}],[["$","section","Start with a suitable reference",{"id":"s0","children":[["$","h2",null,{"children":"Start with a suitable reference"}],[["$","p","Use a sharp photograph with the entire face visible, neutral light and no strong beauty filter. Avoid sunglasses, extreme wide-angle selfies and hair covering important facial landmarks. A model cannot preserve information that the source does not clearly provide.",{"children":"Use a sharp photograph with the entire face visible, neutral light and no strong beauty filter. Avoid sunglasses, extreme wide-angle selfies and hair covering important facial landmarks. A model cannot preserve information that the source does not clearly provide."}],["$","p","The reference does not need a studio background. A simple phone photograph can work when eyes, jawline, hairline and skin tone are visible. Use the highest-resolution original rather than a screenshot downloaded from social media.",{"children":"The reference does not need a studio background. A simple phone photograph can work when eyes, jawline, hairline and skin tone are visible. Use the highest-resolution original rather than a screenshot downloaded from social media."}]]]}],["$","section","Separate identity from presentation",{"id":"s1","children":[["$","h2",null,{"children":"Separate identity from presentation"}],[["$","p","List what must remain unchanged: facial structure, eye shape, nose, smile, age, skin tone, hairline and any distinctive features. Then describe what may change: wardrobe, background, lighting, crop and posture.",{"children":"List what must remain unchanged: facial structure, eye shape, nose, smile, age, skin tone, hairline and any distinctive features. Then describe what may change: wardrobe, background, lighting, crop and posture."}],["$","p","Avoid instructions such as “make me more attractive” or “perfect the face.” They invite structural changes. Ask instead for even lighting, natural skin texture, temporary blemish reduction and a confident but authentic expression.",{"children":"Avoid instructions such as “make me more attractive” or “perfect the face.” They invite structural changes. Ask instead for even lighting, natural skin texture, temporary blemish reduction and a confident but authentic expression."}]]]}],["$","section","Match the profession and context",{"id":"s2","children":["$L11",["$L12","$L13"]]}],"$L14"],"$L15","$L16"]}]]
