0:{"buildId":"NN9CzL3ZWBiiJQMiqd1H1","data":[{"rsc":["$","$1","c",{"children":[[["$","section",null,{"className":"pageHero","children":[["$","span",null,{"children":"E-COMMERCE · 11 MIN"}],["$","h1",null,{"children":"AI Product Photography Prompts for E-commerce."}],["$","p",null,{"children":"A workflow for packshots, lifestyle scenes and campaign images without redesigning the product."}]]}],["$","article",null,{"className":"article guideArticle","children":[["$","div",null,{"className":"articleMeta","children":[["$","span",null,{"children":"Published September 3, 2026"}],["$","span",null,{"children":"Editorial team · PromptStudio AI"}]]}],["$","p",null,{"className":"lead","children":"E-commerce imagery has two obligations: attract attention and represent the item honestly. Prompting must protect product truth while giving art direction enough room to create context."}],["$","nav",null,{"className":"toc","children":[["$","b",null,{"children":"IN THIS GUIDE"}],[["$","a","Choose the image job",{"href":"#s0","children":[1,". ","Choose the image job"]}],["$","a","Declare product details immutable",{"href":"#s1","children":[2,". ","Declare product details immutable"]}],["$","a","Build physically believable scenes",{"href":"#s2","children":[3,". ","Build physically believable scenes"]}],["$","a","Quality-control before publishing",{"href":"#s3","children":[4,". ","Quality-control before publishing"]}]]]}],[["$","section","Choose the image job",{"id":"s0","children":[["$","h2",null,{"children":"Choose the image job"}],[["$","p","A main marketplace image, a secondary feature image and a paid-social campaign have different requirements. Main images usually prioritize clean isolation and compliance. Secondary images explain scale or use. Campaign images create desire and reserve space for copy.",{"children":"A main marketplace image, a secondary feature image and a paid-social campaign have different requirements. Main images usually prioritize clean isolation and compliance. Secondary images explain scale or use. Campaign images create desire and reserve space for copy."}],["$","p","Write separate prompts for each job. Trying to create one image that is simultaneously compliant, emotional, instructional and editorial usually creates a weak compromise.",{"children":"Write separate prompts for each job. Trying to create one image that is simultaneously compliant, emotional, instructional and editorial usually creates a weak compromise."}]]]}],["$","section","Declare product details immutable",{"id":"s1","children":[["$","h2",null,{"children":"Declare product details immutable"}],[["$","p","Tell the model not to change geometry, color, label, closure, included parts or material texture. For transparent and reflective products, mention accurate refraction and reflections. For apparel, protect seams, neckline, pattern placement and fabric weight.",{"children":"Tell the model not to change geometry, color, label, closure, included parts or material texture. For transparent and reflective products, mention accurate refraction and reflections. For apparel, protect seams, neckline, pattern placement and fabric weight."}],["$","p","Use a clean source photo with the item visible from the angle you need. Generative tools can invent hidden surfaces; do not rely on those inventions for a product listing.",{"children":"Use a clean source photo with the item visible from the angle you need. Generative tools can invent hidden surfaces; do not rely on those inventions for a product listing."}]]]}],["$","section","Build physically believable scenes",{"id":"s2","children":[["$","h2",null,{"children":"Build physically believable scenes"}],[["$","p","A product must have contact shadow, environmental reflections and scale consistent with nearby objects. State the supporting surface and light direction. Keep props restrained and relevant to the target customer.",{"children":"A product must have contact shadow, environmental reflections and scale consistent with nearby objects. State the supporting surface and light direction. Keep props restrained and relevant to the target customer."}],"$L2"]]}],"$L3"],"$L4","$L5"]}]],null,"$L6"]}],"isPartial":"$@7","staleTime":"$8","varyParams":null},{"rsc":"$L9","isPartial":"$@a","staleTime":"$8","varyParams":null},{"rsc":"$Lb","isPartial":"$@c","staleTime":"$8","varyParams":"$d"},{"rsc":"$Le","isPartial":"$@f","staleTime":"$8","varyParams":"$d"},{"rsc":"$L10","isPartial":"$@11","staleTime":"$8","varyParams":null}],"isUpgradeableISRFallback":false,"a":"$@12","rootVaryParams":null,"needsRuntimeRequest":"$@13"}
