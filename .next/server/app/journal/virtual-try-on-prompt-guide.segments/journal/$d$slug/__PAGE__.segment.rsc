0:{"buildId":"NN9CzL3ZWBiiJQMiqd1H1","data":[{"rsc":["$","$1","c",{"children":[[["$","section",null,{"className":"pageHero","children":[["$","span",null,{"children":"FASHION E-COMMERCE · 10 MIN"}],["$","h1",null,{"children":"Virtual Try-On Prompts for Fashion E-commerce."}],["$","p",null,{"children":"Preserve garment construction while creating believable fit and drape."}]]}],["$","article",null,{"className":"article guideArticle","children":[["$","div",null,{"className":"articleMeta","children":[["$","span",null,{"children":"Published September 3, 2026"}],["$","span",null,{"children":"Editorial team · PromptStudio AI"}]]}],["$","p",null,{"className":"lead","children":"A useful virtual try-on image must preserve both the person and the garment. If either changes, the result may be attractive but commercially misleading."}],["$","nav",null,{"className":"toc","children":[["$","b",null,{"children":"IN THIS GUIDE"}],[["$","a","Prepare garment and model references",{"href":"#s0","children":[1,". ","Prepare garment and model references"]}],["$","a","Describe construction, not just style",{"href":"#s1","children":[2,". ","Describe construction, not just style"]}],["$","a","Direct fit and physical interaction",{"href":"#s2","children":[3,". ","Direct fit and physical interaction"]}],["$","a","Use try-on imagery responsibly",{"href":"#s3","children":[4,". ","Use try-on imagery responsibly"]}]]]}],[["$","section","Prepare garment and model references",{"id":"s0","children":[["$","h2",null,{"children":"Prepare garment and model references"}],[["$","p","Use a clean front-facing garment image or ghost-mannequin shot with accurate color. The model reference should show the intended pose, body proportions and unobstructed areas where the garment will sit.",{"children":"Use a clean front-facing garment image or ghost-mannequin shot with accurate color. The model reference should show the intended pose, body proportions and unobstructed areas where the garment will sit."}],["$","p","Patterns, trims and closures need enough resolution to survive the transformation. Include additional views for complex backs, sleeves or asymmetric construction.",{"children":"Patterns, trims and closures need enough resolution to survive the transformation. Include additional views for complex backs, sleeves or asymmetric construction."}]]]}],["$","section","Describe construction, not just style",{"id":"s1","children":[["$","h2",null,{"children":"Describe construction, not just style"}],[["$","p","List neckline, sleeve length, hem, seams, fasteners, pockets, pattern placement and fabric. Describe fabric weight because silk, denim and wool fold differently.",{"children":"List neckline, sleeve length, hem, seams, fasteners, pockets, pattern placement and fabric. Describe fabric weight because silk, denim and wool fold differently."}],["$","p","Tell the model not to redesign the garment or change body proportions. Styling preferences should never override product accuracy.",{"children":"Tell the model not to redesign the garment or change body proportions. Styling preferences should never override product accuracy."}]]]}],["$","section","Direct fit and physical interaction",{"id":"s2","children":[["$","h2",null,{"children":"Direct fit and physical interaction"}],[["$","p","Specify intended fit—relaxed, tailored, oversized or close-fitting—and ask for natural tension around shoulders, elbows and waist. Hair, hands and accessories should occlude fabric correctly.",{"children":"Specify intended fit—relaxed, tailored, oversized or close-fitting—and ask for natural tension around shoulders, elbows and waist. Hair, hands and accessories should occlude fabric correctly."}],["$","p","Check gravity, mirrored details and repeated patterns. Garments often look plausible until compared directly with the product photo.",{"children":"Check gravity, mirrored details and repeated patterns. Garments often look plausible until compared directly with the product photo."}]]]}],"$L2"],"$L3","$L4"]}]],null,"$L5"]}],"isPartial":"$@6","staleTime":"$7","varyParams":null},{"rsc":"$L8","isPartial":"$@9","staleTime":"$7","varyParams":null},{"rsc":"$La","isPartial":"$@b","staleTime":"$7","varyParams":"$c"},{"rsc":"$Ld","isPartial":"$@e","staleTime":"$7","varyParams":"$c"},{"rsc":"$Lf","isPartial":"$@10","staleTime":"$7","varyParams":null}],"isUpgradeableISRFallback":false,"a":"$@11","rootVaryParams":null,"needsRuntimeRequest":"$@12"}
