2:["$","section","Use try-on imagery responsibly",{"id":"s3","children":[["$","h2",null,{"children":"Use try-on imagery responsibly"}],[["$","p","Do not claim exact fit when the image is synthetic. Provide real measurements, size information and conventional product photographs alongside generated imagery.",{"children":"Do not claim exact fit when the image is synthetic. Provide real measurements, size information and conventional product photographs alongside generated imagery."}],["$","p","Use diverse, permissioned model references and avoid changing protected personal characteristics without consent.",{"children":"Use diverse, permissioned model references and avoid changing protected personal characteristics without consent."}]]]}]
